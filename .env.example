# Copia este archivo como .env y rellénalo. El .env nunca se sube al repositorio.

# Secretos
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
# Cadena aleatoria larga. No la cambies una vez en uso.
USER_ID_SALT=

# Lista blanca: ids numéricos de Telegram (@userinfobot), separados por comas
ALLOWED_USER_IDS=

# Idioma del bot: es (normal) o en (solo para demos en inglés)
BOT_LANGUAGE=es

# Opcionales
# ANTHROPIC_MODEL=claude-sonnet-5-5
# JUDGE_MODEL=
# WHISPER_MODEL=small
# RETENTION_DAYS=30
# DEBUG_LOG_CONTENT=false
