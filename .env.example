# Copia este fichero como .env y rellena los valores. .env NUNCA se sube al repositorio.

# Token del bot (créalo con @BotFather)
TELEGRAM_BOT_TOKEN=
# Clave de la API de Anthropic
ANTHROPIC_API_KEY=
# Sal para el hash de los ids de Telegram (cadena larga y aleatoria)
USER_ID_SALT=

# Ids numéricos de Telegram autorizados, separados por comas (lista blanca del prototipo)
ALLOWED_USER_IDS=

# Modelos
ANTHROPIC_MODEL=claude-sonnet-5-5
JUDGE_MODEL=
WHISPER_MODEL=small
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Almacenamiento: por defecto SQLite en var/nflb.db.
# Para PostgreSQL + pgvector (docker compose up -d):
# DATABASE_URL=postgresql+psycopg://nflb:nflb@localhost:5432/nflb
# VECTOR_BACKEND=pgvector

# Retención (días sin actividad antes de borrar los datos)
RETENTION_DAYS=30

# Depuración: registrar el contenido de los mensajes en los logs (NO activar con datos reales)
DEBUG_LOG_CONTENT=false
